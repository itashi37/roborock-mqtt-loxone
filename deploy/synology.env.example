# Facultatif : copiez ce fichier en .env à côté de compose.synology.yaml.
# Installation existante : conservez votre port et votre volume actuels.
ROBOROCK_WEB_PORT=8080
TZ=Europe/Paris
ROBOROCK_IMAGE=ghcr.io/itashi37/roborock-mqtt-loxone:latest
# Adaptez cette valeur au groupe du socket Docker si nécessaire.
DOCKER_GID=0
# Laissez cette ligne commentée pour utiliser le volume Docker par défaut.
# ROBOROCK_DATA_DIR=/volume1/docker/roborock-mqtt-loxone/data
